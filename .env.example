# Opcional: caminho alternativo para o banco SQLite.
PRODUCT_MANAGER_DB=db/product_manager.db
PRODUCT_MANAGER_HOST=127.0.0.1
PRODUCT_MANAGER_PORT=8000
# Optional HTTPS endpoint owned by your organization. Leave empty to disable.
PRODUCT_MANAGER_TELEMETRY_URL=
# Optional Google Sheets export. Keep this short-lived token in a secret manager,
# never in source control, the frontend, a URL, or application logs.
PRODUCT_MANAGER_GOOGLE_SHEETS_SPREADSHEET_ID=
PRODUCT_MANAGER_GOOGLE_SHEETS_ACCESS_TOKEN=
PRODUCT_MANAGER_GOOGLE_SHEETS_RANGE=Export!A1
